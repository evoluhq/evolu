{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["node"],
    // The base config's lib, plus es2023.array for test/bindingConformance.ts's
    // toSorted. The polyfills install only Array.prototype.toSorted, not the
    // other methods it declares.
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.error",
      "es2022.object",
      "es2022.string",
      "es2023.array",
      "es2024.promise",
      "esnext.promise"
    ]
  },
  "include": ["**/*.ts", "**/*.tsx", "*.js"],
  "exclude": ["**/node_modules", "**/Pods"]
}
