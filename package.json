{
  "private": true,
  "name": "@evolu/monorepo",
  "scripts": {
    "dev": "turbo run dev --filter=relay --filter=web",
    "relay": "turbo --filter relay dev",
    "build": "pnpm clean:ts && turbo --filter \"@evolu/*\" --filter relay build",
    "build:web": "pnpm build && pnpm build:docs && turbo --filter web build",
    "build:docs": "typedoc && pnpm --dir apps/web fix:docs",
    "build:expo": "turbo --filter @example/react-expo build",
    "typecheck": "tsc --build tsconfig.typecheck.json && tsc --project packages/oxlint-config/tsconfig.json --noEmit && tsc --project scripts/tsconfig.json && tsc --project bench/tsconfig.json --noEmit && tsc --project test/tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:bundle && pnpm test:jsdoc",
    "test:node": "node --experimental-default-config-file",
    "test:unit": "pnpm test:node --test-coverage-branches=97 --test-coverage-functions=91 --test-coverage-lines=90 --test-reporter=dot \"{apps/web/src,bench,packages/*/src,scripts,test/jsdoc}/**/*.test.{ts,mts}\"",
    "test:unit-overview": "pnpm test:node --test-coverage-branches=97 --test-coverage-functions=91 --test-coverage-lines=90 --test-reporter=@evolu/nodejs/TestOverviewReporter \"{apps/web/src,bench,packages/*/src,scripts,test/jsdoc}/**/*.test.{ts,mts}\"",
    "test:integration": "pnpm test:integration:nodejs && pnpm test:integration:browsers",
    "test:integration:nodejs": "pnpm test:node --no-experimental-test-coverage --test-reporter=@evolu/nodejs/TestOverviewReporter \"test/integration/nodejs/**/*.test.ts\" && vitest run --reporter=default --project=node-integration",
    "test:integration:browsers": "vitest run --coverage --mode=chromium --project='browser-*' && vitest run --mode=firefox-webkit --project='browser-*'",
    "test:bundle": "node --disable-warning=ExperimentalWarning --test --test-isolation=none --test-timeout=60000 \"test/bundle/**/*.test.ts\"",
    "test:jsdoc": "node test/jsdoc/test-jsdoc.mts",
    "playwright:install": "playwright install chromium firefox webkit",
    "bench:json-codec": "node bench/json-codec/benchmark.mts",
    "bench:storage": "node bench/storage/benchmark.mts",
    "bench:type": "node bench/type/benchmark.mts",
    "check:packages": "node scripts/check-packages.mts",
    "start": "turbo start",
    "lint": "pnpm lint:oxlint && pnpm lint:sherif",
    "lint:oxlint": "oxlint .",
    "lint:sherif": "sherif --ignore-dependency react@19.2.0",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm build && pnpm check:packages && pnpm build:docs && pnpm test",
    "clean:ts": "tsc --build --clean tsconfig.typecheck.json tsconfig.build.json",
    "clean:dry": "git clean -Xnd",
    "// clean": "Retry because macOS can report large hoisted node_modules trees as non-empty while cleaning.",
    "clean": "git clean -Xdf || git clean -Xdf || git clean -Xdf || git clean -Xdf",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,md,mdx}\"",
    "version": "changeset version",
    "release": "pnpm build && pnpm changeset publish",
    "ios": "pnpm --dir examples/react-expo ios",
    "android": "pnpm --dir examples/react-expo android",
    "examples:toggle-deps": "node ./scripts/toggle-examples-deps.mts",
    "examples:build": "turbo --filter \"@example/*\" build",
    "examples:react-nextjs:dev": "turbo --filter @example/react-nextjs dev",
    "examples:react-vite-pwa:dev": "turbo --filter @example/react-vite-pwa dev",
    "examples:svelte-vite-pwa:dev": "turbo --filter @example/svelte-vite-pwa dev",
    "examples:vue-vite-pwa:dev": "turbo --filter @example/vue-vite-pwa dev"
  },
  "devDependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@changesets/cli": "^3.0.1",
    "@evolu/common": "workspace:*",
    "@evolu/nodejs": "workspace:*",
    "@evolu/oxlint-config": "workspace:*",
    "@evolu/typescript-config": "workspace:*",
    "@evolu/vitest": "workspace:*",
    "@paulmillr/jsbt": "0.7.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^24.10.9",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^12.11.1",
    "msgpackr": "2.0.5",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-jsdoc": "^1.8.0",
    "prettier-plugin-sql-cst": "^0.22.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sherif": "1.13.0",
    "turbo": "^2.10.11",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "webpack": "^5.109.2",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
