{
  "name": "@evolu/relay",
  "version": "4.0.1",
  "description": "Evolu Relay server",
  "keywords": [
    "evolu",
    "local-first",
    "relay",
    "sync"
  ],
  "author": "Daniel Steigerwald <daniel@steigerwald.cz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoluhq/evolu.git"
  },
  "bugs": {
    "url": "https://github.com/evoluhq/evolu/issues"
  },
  "homepage": "https://evolu.dev",
  "type": "module",
  "bin": {
    "evolu-relay": "./dist/src/index.js"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/index.ts",
    "build": "tsc --build tsconfig.json",
    "start": "node dist/src/index.js"
  },
  "files": [
    "dist/src/**",
    "README.md"
  ],
  "dependencies": {
    "@evolu/common": "workspace:*",
    "@evolu/nodejs": "workspace:*"
  },
  "devDependencies": {
    "@evolu/typescript-config": "workspace:*",
    "@types/node": "^24.10.9",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
