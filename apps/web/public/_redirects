# Cloudflare redirects for the static export, which cannot use Next.js redirects.
# https://developers.cloudflare.com/workers/static-assets/redirects/
/docs/migrations /docs/schema 308
/docs/migrations/ /docs/schema 308
/docs/migrations.md /docs/schema.md 308

# The full playground's variants live under it, so its own URL has no page.
/playgrounds/full /playgrounds/full/instant 308

# The full playground replaced these.
/playgrounds/local-only /playgrounds/full/instant 308
/playgrounds/sync /playgrounds/full/instant 308
/playgrounds/multitenant /playgrounds/full/instant 308

# Vercel redirected trailing slashes with 308. Without this rule, the default
# html_handling does it with a temporary 307. A dynamic rule, so it stays last:
# Wrangler treats every rule after the first dynamic one as dynamic.
/*/ /:splat 308
