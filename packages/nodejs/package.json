{
  "name": "@evolu/nodejs",
  "version": "3.1.0",
  "description": "Evolu for Node.js",
  "author": "Daniel Steigerwald <daniel@steigerwald.cz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoluhq/evolu.git"
  },
  "bugs": {
    "url": "https://github.com/evoluhq/evolu/issues"
  },
  "homepage": "https://evolu.dev",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./TestBundle": {
      "types": "./dist/src/TestBundle.d.ts",
      "default": "./src/TestBundle.ts"
    },
    "./TestJSDoc": {
      "types": "./dist/src/TestJSDoc.d.ts",
      "default": "./src/TestJSDoc.ts"
    },
    "./TestOverviewReporter": {
      "types": "./dist/src/TestOverviewReporter.d.ts",
      "default": "./src/TestOverviewReporter.ts"
    }
  },
  "typesVersions": {
    "*": {
      "TestBundle": [
        "./dist/src/TestBundle.d.ts"
      ],
      "TestJSDoc": [
        "./dist/src/TestJSDoc.d.ts"
      ],
      "TestOverviewReporter": [
        "./dist/src/TestOverviewReporter.d.ts"
      ]
    }
  },
  "files": [
    "dist/src/**",
    "!dist/**/*.test.*",
    "src/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "npm run build",
    "format": "prettier --write \"src/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@evolu/common": "workspace:*",
    "@evolu/oxlint-config": "workspace:*",
    "@evolu/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.9",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "vite": "^8.2.2",
    "webpack": "^5.109.2"
  },
  "peerDependencies": {
    "@evolu/common": "^8.0.0",
    "@evolu/oxlint-config": "^0.1.0",
    "@evolu/typescript-config": "^0.1.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": ">=7.0.0",
    "vite": ">=8.0.0",
    "webpack": ">=5.108.4"
  },
  "peerDependenciesMeta": {
    "@evolu/oxlint-config": {
      "optional": true
    },
    "@evolu/typescript-config": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js",
        "default": "./dist/src/index.js"
      },
      "./TestBundle": {
        "types": "./dist/src/TestBundle.d.ts",
        "import": "./dist/src/TestBundle.js",
        "default": "./dist/src/TestBundle.js"
      },
      "./TestJSDoc": {
        "types": "./dist/src/TestJSDoc.d.ts",
        "import": "./dist/src/TestJSDoc.js",
        "default": "./dist/src/TestJSDoc.js"
      },
      "./TestOverviewReporter": {
        "types": "./dist/src/TestOverviewReporter.d.ts",
        "import": "./dist/src/TestOverviewReporter.js",
        "default": "./dist/src/TestOverviewReporter.js"
      }
    }
  }
}
