{
  "name": "@evolu/nodejs",
  "version": "3.0.0-next.3",
  "description": "Evolu for Node.js",
  "author": "Daniel Steigerwald <daniel@steigerwald.cz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoluhq/evolu.git"
  },
  "bugs": {
    "url": "https://github.com/evoluhq/evolu/issues"
  },
  "homepage": "https://evolu.dev",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./TestBundle": {
      "types": "./dist/src/TestBundle.d.ts",
      "default": "./src/TestBundle.ts"
    }
  },
  "typesVersions": {
    "*": {
      "TestBundle": [
        "./dist/src/TestBundle.d.ts"
      ]
    }
  },
  "files": [
    "dist/src/**",
    "src/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "npm run build",
    "format": "prettier --write \"src/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@evolu/common": "workspace:*",
    "@evolu/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.9",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vite": "^8.1.5",
    "webpack": "^5.108.4"
  },
  "peerDependencies": {
    "@evolu/common": "^8.0.0-next.0",
    "vite": ">=8.0.0",
    "webpack": ">=5.108.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js",
        "default": "./dist/src/index.js"
      },
      "./TestBundle": {
        "types": "./dist/src/TestBundle.d.ts",
        "import": "./dist/src/TestBundle.js",
        "default": "./dist/src/TestBundle.js"
      }
    }
  }
}
