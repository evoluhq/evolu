{
  "name": "@evolu/react-native",
  "version": "16.2.0",
  "description": "Evolu for React Native and Expo",
  "keywords": [
    "evolu",
    "expo",
    "react-native",
    "react-hooks",
    "sqlite"
  ],
  "author": "Daniel Steigerwald <daniel@steigerwald.cz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoluhq/evolu.git"
  },
  "bugs": {
    "url": "https://github.com/evoluhq/evolu/issues"
  },
  "homepage": "https://evolu.dev",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "react-native": "./src/index.ts",
      "browser": "./src/web.ts",
      "default": "./src/index.ts"
    },
    "./identicon": {
      "types": "./dist/src/identicon.d.ts",
      "react-native": "./src/identicon.ts",
      "default": "./src/identicon.ts"
    },
    "./polyfills": {
      "types": "./dist/src/Polyfills.d.ts",
      "react-native": "./src/Polyfills.ts",
      "browser": "./src/web.ts",
      "default": "./src/Polyfills.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/src/index.d.ts"
      ],
      "identicon": [
        "./dist/src/identicon.d.ts"
      ],
      "polyfills": [
        "./dist/src/Polyfills.d.ts"
      ]
    }
  },
  "files": [
    "dist/src/**",
    "!dist/**/*.test.*",
    "src/**",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "EvoluReactNative.podspec",
    "react-native.config.js",
    "native.json",
    "native/**",
    "cpp/**",
    "ios/**",
    "android/**",
    "!android/build",
    "!android/.cxx"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "npm run build && node scripts/vendor-native.mts",
    "format": "prettier --write \"src/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "array-from-async": "3.0.0",
    "array.prototype.tosorted": "1.1.4",
    "promise.try": "2.0.2",
    "promise.withresolvers": "1.0.4",
    "set.prototype.difference": "1.1.7",
    "set.prototype.intersection": "1.1.8",
    "set.prototype.isdisjointfrom": "1.1.5",
    "set.prototype.issubsetof": "1.1.4",
    "set.prototype.issupersetof": "1.1.3",
    "set.prototype.symmetricdifference": "1.1.3",
    "set.prototype.union": "1.1.3"
  },
  "devDependencies": {
    "@evolu/common": "workspace:*",
    "@evolu/react": "workspace:*",
    "@evolu/sqlite-core": "workspace:*",
    "@evolu/typescript-config": "workspace:*",
    "@react-native/metro-config": "0.88.0",
    "@types/node": "^24.19.2",
    "@types/react": "catalog:react19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "react": "catalog:react19",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@evolu/common": "^8.24.0",
    "@evolu/react": "^11.2.2",
    "react": ">=19",
    "react-native": ">=0.88",
    "react-native-svg": ">=15.15"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "react-native": "./dist/src/index.js",
        "browser": "./dist/src/web.js",
        "default": "./dist/src/index.js"
      },
      "./identicon": {
        "types": "./dist/src/identicon.d.ts",
        "react-native": "./dist/src/identicon.js",
        "default": "./dist/src/identicon.js"
      },
      "./polyfills": {
        "types": "./dist/src/Polyfills.d.ts",
        "react-native": "./dist/src/Polyfills.js",
        "browser": "./dist/src/web.js",
        "default": "./dist/src/Polyfills.js"
      }
    }
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "sideEffects": false,
  "codegenConfig": {
    "name": "EvoluReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.evolu.reactnative"
    },
    "ios": {
      "modules": {
        "EvoluSqlite": {
          "className": "EvoluSqliteProvider"
        },
        "EvoluApp": {
          "className": "EvoluApp"
        }
      }
    }
  }
}
