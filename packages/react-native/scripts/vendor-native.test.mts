      headers: () => "",
    },
    {
      source: join(coreDirectory, "vendor/lib/src/aes.c"),
      flags: ["-std=c11", include("vendor/lib/inc"), include("vendor/lib/src")],
      headers: () => "",
    },
    {
      source: join(coreDirectory, "vendor/mono/monocypher.c"),
      flags: ["-std=c11", include("vendor/mono")],
      headers: () => "",
    },
    {
      source: join(coreDirectory, "binding/evolu_database.c"),
      flags: [...coreFlags, include("binding")],
      headers: () => "",
    },
  ];
  const directory = join(root, "native");
  return {
    coreDirectory,
    directory,
    inputs: {
      sqlite,
      source: sqliteSource,
      units,
      coreDirectory,
      objectsDirectory: join(root, "objects"),
      directory,
    },
  };
};

/**
 * A package directory whose native.json lists four units, one of each kind,
 * with native/'s digest of it, and a directory for the objects.
 */
const setupNative = (t: TestContext) => {
  const packageDirectory = mkdtempSync(
    join(tmpdir(), "evolu-react-native-package-"),
  );
  t.after(() => {
    rmSync(packageDirectory, { recursive: true, force: true });
  });
  const file = (origin: string) => ({ origin, sha256: "0".repeat(64) });
  const manifest: NativeManifest = {
    sqlite: {
      version: sqliteSource.version,
      url: sqliteSource.url,
      hash: sqliteSource.hash,
      checkIn: sqliteSource.checkIn,
    },
    flags: shippedFlags,
    files: {
      "c/aes_ct.c": file("@evolu/sqlite-core/vendor/bearssl/src/aes_ct.c"),
      "c/evolu_codec.c": file("@evolu/sqlite-core/src/evolu_codec.c"),
      "c/evolu_database.c": file("@evolu/sqlite-core/binding/evolu_database.c"),
      "c/sqlite3.c": file("sqlite-src-3540100.zip, make sqlite3.c"),
      "include/evolu_names.h": file("vendor-native.mts"),
      "units/aes_ct.c": file("vendor-native.mts"),
      "units/evolu_codec.c": file("vendor-native.mts"),
      "units/evolu_database.c": file("vendor-native.mts"),
      "units/sqlite3.c": file("vendor-native.mts"),
    },
  };
  const text = `${JSON.stringify(manifest, null, 2)}\n`;
  writeFileSync(join(packageDirectory, "native.json"), text);
  mkdirSync(join(packageDirectory, "native"));
  writeFileSync(
    join(packageDirectory, "native/native.json.sha256"),
    `${sha256(text)}\n`,
  );
  mkdirSync(join(packageDirectory, "cpp"));
  writeFileSync(join(packageDirectory, "cpp/EvoluSqliteBinding.cpp"), "");
  const errors = ["-Wall", "-Wextra", "-Werror"];
  return {
    packageDirectory,
    /** Where React Native's JSI headers would be. */
    jsiDirectory: join(packageDirectory, "jsi"),
    outputDirectory: join(packageDirectory, "objects"),
    /** Each unit and the flags the cross-compile adds to it. */
    units: [
      ["aes_ct", []],
      ["evolu_codec", errors],
      ["evolu_database", errors],
      ["sqlite3", ["-Werror=macro-redefined"]],
    ] as const,
  };
};

/**
 * Symbols that pass the check: five defined globals of the C, each evolu_, and
 * five of the adapter: its own, the instantiations of std's and JSI's
 * templates, and the compiler's helpers.
 */
const setNamedSymbols = (toolchain: FakeToolchain): void => {
  toolchain.setSymbols("EvoluSqliteBinding.cpp", [
    "_ZN5evolu13createBindingERN8facebook3jsi7RuntimeE T 0 0",
    "_ZNSt3__16vectorIiNS_9allocatorIiEEE9push_backEOi W 0 0",
    "_ZNR8facebook3jsi6Object8getArrayERNS0_8IRuntimeE W 0 0",
    "__clang_call_terminate W 0 0",
    "DW.ref.__gxx_personality_v0 V 0 0",
    // A vtable, typeinfo, a guard variable, a local name and two thunks.
    "_ZTVN5evolu12ExportBufferE D 0 0",
    "_ZTINSt3__120__shared_ptr_emplaceIN5evolu18RuntimeConnectionsENS_9allocatorIS2_EEEE V 0 0",
    "_ZGVZN5evolu1fEvE1x V 0 0",
    "_ZZN5evolu1fEvE1x V 0 0",
    "_ZThn8_N5evolu1A1fEv T 0 0",
    "_ZTv0_n24_N5evolu1A1fEv T 0 0",
    "_ZN8facebook3jsi5ValueD1Ev U",
    "evolu_database_open U",
    "evolu_sqlite3_step U",
  ]);
  toolchain.setSymbols("aes_ct.c", ["evolu_br_aes_ct_init T 0 0", "memcpy U"]);
  toolchain.setSymbols("evolu_codec.c", [
    "evolu_codec_open T 0 0",
    "evolu_sqlite3_open U",
    "evolu_br_aes_ct_init U",
  ]);
  toolchain.setSymbols("evolu_database.c", ["evolu_database_open T 0 0"]);
  toolchain.setSymbols("sqlite3.c", [
    "evolu_sqlite3_open T 0 0",
    "evolu_sqlite3_temp_directory B 0 0",
    "fstat U",
    "__emutls_get_address U",
  ]);
};

/**
 * The objects Xcode compiles for Evolu's pod in a new directory, holding the
 * llvm-nm -P lines of each, which the fake llvm-nm prints, with `overrides` in
 * place of an object's lines or as an object of their own: the units of
 * {@link setupNative}'s native.json, the adapter, the TurboModule, the two
 * ObjC++ classes and the pod's dummy class, which CocoaPods generates.
 */
const setupPodObjects = (
  t: TestContext,
  overrides: Readonly<Record<string, ReadonlyArray<string>>> = {},
) => {
  const directory = mkdtempSync(join(tmpdir(), "evolu-react-native-pod-"));
  t.after(() => {
    rmSync(directory, { recursive: true, force: true });
  });
  const objects: Readonly<Record<string, ReadonlyArray<string>>> = {
    "aes_ct.o": ["evolu_br_aes_ct_init T 0 0", "memcpy U"],
    "evolu_codec.o": ["evolu_codec_open T 0 0", "evolu_sqlite3_open U"],
    "evolu_database.o": ["evolu_database_open T 0 0"],
    "sqlite3.o": ["evolu_sqlite3_open T 0 0", "fstat U"],
    "EvoluSqliteBinding.o": [
      "_ZN5evolu13createBindingERN8facebook3jsi7RuntimeE T 0 0",
      "_ZNSt3__16vectorIiNS_9allocatorIiEEE9push_backEOi T 0 0",
      "_ZNR8facebook3jsi6Object8getArrayERNS0_8IRuntimeE T 0 0",
      "evolu_database_open U",
    ],
    // The TurboModule's own class, global, as the generated provider needs.
    "EvoluSqlite.o": [
      "_ZN11EvoluSqliteC2ENSt3__110shared_ptrIN8facebook5react12CallInvokerEEE T 0 0",
      "_ZN11EvoluSqliteD2Ev T 0 0",
      "_ZTV11EvoluSqlite S 0 0",
      "_ZTI11EvoluSqlite S 0 0",
      "_ZTS11EvoluSqlite S 0 0",
      "_ZN8facebook5react24NativeEvoluSqliteCxxSpecI11EvoluSqliteE11kModuleNameE S 0 0",
      "__clang_call_terminate T 0 0",
      "_ZN5evolu13createBindingERN8facebook3jsi7RuntimeERKNSt3__110shared_ptrINS_18RuntimeConnectionsEEE U",
    ],
    "EvoluApp.o": [
      "OBJC_CLASS_$_EvoluApp S 0 0",
      "OBJC_METACLASS_$_EvoluApp S 0 0",
      "_OBJC_PROTOCOL_$_NativeEvoluAppSpec S 0 0",
      "_OBJC_LABEL_PROTOCOL_$_NativeEvoluAppSpec S 0 0",
      "_ZNSt3__110shared_ptrIN8facebook5react11TurboModuleEED2Ev T 0 0",
      // The descriptor of a block, which clang emits for dispatch_async's.
      "__block_descriptor_32_e5_v8?0l S 0 0",
      "RCTTriggerReloadCommandListeners U",
    ],
    "EvoluSqliteProvider.o": [
      "OBJC_CLASS_$_EvoluSqliteProvider S 0 0",
      "OBJC_METACLASS_$_EvoluSqliteProvider S 0 0",
      "_OBJC_PROTOCOL_$_RCTModuleProvider S 0 0",
      "_ZNSt3__120__shared_ptr_emplaceI11EvoluSqliteNS_9allocatorIS1_EEED1Ev T 0 0",
    ],
    "EvoluReactNative-dummy.o": [
      "OBJC_CLASS_$_PodsDummy_EvoluReactNative S 0 0",
      "OBJC_METACLASS_$_PodsDummy_EvoluReactNative S 0 0",
    ],
  };
  for (const [object, lines] of Object.entries({ ...objects, ...overrides }))
    writeFileSync(
      join(directory, object),
      lines.map((line) => `_${line}\n`).join(""),
    );
  return { directory };
};

const byArguments = (
  a: ReadonlyArray<string>,
  b: ReadonlyArray<string>,
): number => {
  const left = a.join("\n");
  const right = b.join("\n");
  return left < right ? -1 : left > right ? 1 : 0;
};

const sha256 = (bytes: string | Uint8Array): string =>
  createHash("sha256").update(bytes).digest("hex");
