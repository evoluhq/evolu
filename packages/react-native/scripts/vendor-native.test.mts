/**
 * The vendor script's generation, its comparison with native.json, its
 * cross-compile and its command line, with a fake clang, llvm-nm and xcrun, so
 * they need no toolchain and test:unit runs them too.
 * test/node/vendor-native.test.mts runs the real ones.
 */
import {
  assertEqual,
  assertFalse,
  assertRejects,
  assertThrows,
  assertTrue,
} from "@evolu/common";
import type { CompileUnit } from "@evolu/sqlite-core/scripts/compile.mts";
import {
  type PreparedSqlite,
  sqliteSource,
} from "@evolu/sqlite-core/scripts/sqlite-source.mts";
import { createHash } from "node:crypto";
import {
  existsSync,
  mkdirSync,
  mkdtempSync,
  readdirSync,
  readFileSync,
  rmSync,
  symlinkSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join } from "node:path";
import { describe, it, type TestContext } from "node:test";
import {
  checkObjects,
  compareManifests,
  crossCompile,
  generateNative,
  type NativeManifest,
  runVendorNativeCli,
  shippedFlags,
} from "./vendor-native.mts";

describe("generateNative", () => {
  it("writes SQLite, the core and the vendored libraries flat in c/, the public and generated headers in include/ and a unit per source", (t) => {
    const toolchain = setupFakeToolchain(t);
    const core = setupCore(t);
    toolchain.setSymbols("evolu_codec.c", [
      "evolu_codec_open T 0 0",
      "br_aes_init U",
    ]);
    toolchain.setSymbols("evolu_database.c", ["evolu_database_open T 0 0"]);
    toolchain.setSymbols("aes.c", [
      "br_aes_init T 0 0",
      "br_aes_vtable R 0 0",
      "memcpy U",
    ]);
    toolchain.setSymbols("monocypher.c", ["crypto_wipe T 0 0"]);

    const manifest = generateNative({ ...core.inputs, cc: toolchain.cc });

    const generated = "vendor-native.mts";
    const amalgamation = "sqlite-src-3540100.zip, make sqlite3.c";
    assertEqual(
      Object.entries(manifest.files).map(([path, { origin }]) => [
        path,
        origin,
      ]),
      [
        ["c/aes.c", "@evolu/sqlite-core/vendor/lib/src/aes.c"],
        ["c/evolu_codec.c", "@evolu/sqlite-core/src/evolu_codec.c"],
        ["c/evolu_codec.h", "@evolu/sqlite-core/src/evolu_codec.h"],
        ["c/evolu_database.c", "@evolu/sqlite-core/binding/evolu_database.c"],
        ["c/inner.h", "@evolu/sqlite-core/vendor/lib/src/inner.h"],
        ["c/lib.h", "@evolu/sqlite-core/vendor/lib/inc/lib.h"],
        ["c/monocypher.c", "@evolu/sqlite-core/vendor/mono/monocypher.c"],
        ["c/monocypher.h", "@evolu/sqlite-core/vendor/mono/monocypher.h"],
        ["c/sqlite3.c", amalgamation],
        ["c/sqlite3.h", amalgamation],
        ["c/sqlite_config.h", "@evolu/sqlite-core/src/sqlite_config.h"],
        [
          "include/evolu_database.h",
          "@evolu/sqlite-core/binding/evolu_database.h",
        ],
        ["include/evolu_names.h", generated],
        ["include/evolu_sqlite3.h", generated],
        ["include/evolu_xchacha.h", "@evolu/sqlite-core/src/evolu_xchacha.h"],
        ["units/aes.c", generated],
        ["units/evolu_codec.c", generated],
        ["units/evolu_database.c", generated],
        ["units/monocypher.c", generated],
        ["units/sqlite3.c", generated],
      ],
    );
    for (const [path, { sha256: hash }] of Object.entries(manifest.files))
      assertEqual(sha256(readFileSync(join(core.directory, path))), hash);
    assertEqual(
      readFileSync(join(core.directory, "c/aes.c"), "utf8"),
      readFileSync(join(core.coreDirectory, "vendor/lib/src/aes.c"), "utf8"),
    );
    assertEqual(manifest.sqlite, {
      version: sqliteSource.version,
      url: sqliteSource.url,
      hash: sqliteSource.hash,
      checkIn: sqliteSource.checkIn,
    });
    assertEqual(manifest.flags, shippedFlags);
    assertEqual(
      readFileSync(join(core.directory, "include/evolu_names.h"), "utf8"),
      [
        "/*",
        " * Generated by vendor-native.mts. Every global of SQLite, BearSSL and",
        " * Monocypher gets the prefix evolu_, so none binds to another library's copy",
        " * in an app. Every C unit and adapter includes this header first.",
        " */",
        "#ifndef EVOLU_NAMES_H",
        "#define EVOLU_NAMES_H",
        "",
        "#define br_aes_init evolu_br_aes_init",
        "#define br_aes_vtable evolu_br_aes_vtable",
        "#define crypto_wipe evolu_crypto_wipe",
        "#define sqlite3_open evolu_sqlite3_open",
        "#define sqlite3_temp_directory evolu_sqlite3_temp_directory",
        "#define sqlite3_version evolu_sqlite3_version",
        "#define sqlite3session_create evolu_sqlite3session_create",
        "",
        "#endif",
        "",
      ].join("\n"),
    );
    assertEqual(
      readFileSync(join(core.directory, "include/evolu_sqlite3.h"), "utf8"),
      [
        "/*",
        " * Generated by vendor-native.mts. The pinned SQLite's API under a name no",
        " * other library's header has, so Xcode's header map of every pod's headers",
        " * can't answer it with another pod's sqlite3.h.",
        " */",
        "#ifndef EVOLU_SQLITE3_H",
        "#define EVOLU_SQLITE3_H",
        "",
        '#include "../c/sqlite3.h"',
        "",
        "#endif",
        "",
      ].join("\n"),
    );
    assertEqual(
      readFileSync(join(core.directory, "units/aes.c"), "utf8"),
      [
        "/* Generated by vendor-native.mts: ../c/aes.c with Evolu's names. */",
        '#include "evolu_names.h"',
        '#include "../c/aes.c"',
        "",
      ].join("\n"),
    );
  });

  it("refuses a vendored global outside br_ and crypto_, which the rename wouldn't cover", (t) => {
    const toolchain = setupFakeToolchain(t);
    const core = setupCore(t);
    toolchain.setSymbols("aes.c", ["br_aes_init T 0 0", "aes_table R 0 0"]);

    assertThrows(
      () => generateNative({ ...core.inputs, cc: toolchain.cc }),
      (error) => {
        assertEqual(
          (error as Error).message,
          "@evolu/sqlite-core/vendor/lib/src/aes.c defines aes_table, which the rename covers only with the prefix br_ or crypto_.",
        );
      },
    );
  });

  it("refuses a rename onto a global the core or the binding defines", (t) => {
    const toolchain = setupFakeToolchain(t);
    const core = setupCore(t);
    toolchain.setSymbols("aes.c", ["br_aes_init T 0 0"]);
    toolchain.setSymbols("evolu_database.c", ["evolu_br_aes_init T 0 0"]);

    assertThrows(
      () => generateNative({ ...core.inputs, cc: toolchain.cc }),
      (error) => {
        assertEqual(
          (error as Error).message,
          "The rename of br_aes_init collides with evolu_br_aes_init, which @evolu/sqlite-core/binding/evolu_database.c defines.",
        );
      },
    );
  });

  it("refuses two files with one basename, which the flat c/ can't hold", (t) => {
    const toolchain = setupFakeToolchain(t);
    const core = setupCore(t);
    const other = join(core.coreDirectory, "vendor/lib/src/other/aes.c");
    mkdirSync(dirname(other));
    writeFileSync(other, "");

    assertThrows(
      () =>
        generateNative({
          ...core.inputs,
          units: [
            ...core.inputs.units,
            { source: other, flags: [], headers: () => "" },
          ],
          cc: toolchain.cc,
        }),
      (error) => {
        assertEqual(
          (error as Error).message,
          "c/aes.c would be both @evolu/sqlite-core/vendor/lib/src/aes.c and @evolu/sqlite-core/vendor/lib/src/other/aes.c.",
        );
      },
    );
  });

  it("refuses a SQLITE_API declaration it finds no name in", (t) => {
    const toolchain = setupFakeToolchain(t);
    const core = setupCore(t);
    writeFileSync(
      core.inputs.sqlite.sqlite3h,
      "SQLITE_API int (*sqlite3_hook)(void);\n",
    );

    assertThrows(
      () => generateNative({ ...core.inputs, cc: toolchain.cc }),
      (error) => {
        assertEqual(
          (error as Error).message,
          "sqlite3.h declares SQLITE_API int (*sqlite3_hook)(void); with no name the rename can take.",
        );
      },
    );
  });
});

describe("compareManifests", () => {
  const manifest: NativeManifest = {
    sqlite: {
      version: sqliteSource.version,
      url: sqliteSource.url,
      hash: sqliteSource.hash,
      checkIn: sqliteSource.checkIn,
    },
    flags: shippedFlags,
    files: {
      "c/a.c": { origin: "@evolu/sqlite-core/src/a.c", sha256: "1" },
      "c/b.c": { origin: "@evolu/sqlite-core/src/b.c", sha256: "2" },
    },
  };
  const text = (value: NativeManifest) => `${JSON.stringify(value, null, 2)}\n`;

  it("finds nothing in native.json as --update writes it", () => {
    assertEqual(compareManifests(text(manifest), manifest), []);
  });

  it("lists another pin, other flags, and changed, extra and missing files", () => {
    assertEqual(
      compareManifests(
        text({
          sqlite: { ...manifest.sqlite, version: "3.54.0" },
          flags: { ...shippedFlags, c: [] },
          files: {
            "c/a.c": { origin: "@evolu/sqlite-core/src/a.c", sha256: "0" },
            "c/z.c": { origin: "@evolu/sqlite-core/src/z.c", sha256: "3" },
          },
        }),
        manifest,
      ),
      [
        "the SQLite pin",
        "the shipped flags",
        "changed: c/a.c",
        "extra: c/b.c",
        "missing: c/z.c",
      ],
    );
  });

  it("finds native.json written otherwise", () => {
    assertEqual(compareManifests(JSON.stringify(manifest), manifest), [
      "the formatting",
    ]);
  });
});

describe("crossCompile", () => {
  it("compiles every unit for Android's four ABIs at API 24 with the shipped flags, the core and the binding with -Werror, and the JSI adapter as C++20 with exceptions, RTTI and hidden symbols, and checks their names", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    setNamedSymbols(toolchain);

    const results = await crossCompile({
      packageDirectory: native.packageDirectory,
      jsiDirectory: native.jsiDirectory,
      platform: { name: "android", ndk: toolchain.ndk },
      outputDirectory: native.outputDirectory,
      jobs: 3,
      env: toolchain.env,
    });

    const targets = [
      ["android-arm64-v8a", "aarch64-linux-android24"],
      ["android-armeabi-v7a", "armv7a-linux-androideabi24"],
      ["android-x86", "i686-linux-android24"],
      ["android-x86_64", "x86_64-linux-android24"],
    ];
    assertEqual(
      results,
      targets.map(([target]) => ({
        target,
        objects: 5,
        definedGlobals: 5,
        adapterSymbols: 11,
      })),
    );
    assertEqual(
      toolchain.commands().toSorted(byArguments),
      targets
        .flatMap(([target, triple]) => [
          ...native.units.map(([unit, extra]) => [
            `--target=${triple}`,
            "-O2",
            "-std=c11",
            "-fvisibility=hidden",
            "-DEVOLU_NATIVE_PACKAGE",
            "-DSQLITE_CUSTOM_INCLUDE=sqlite_config.h",
            `-I${native.packageDirectory}/native/include`,
            ...extra,
            "-c",
            `${native.packageDirectory}/native/units/${unit}.c`,
            "-o",
            `${native.outputDirectory}/${target}/${unit}.o`,
          ]),
          [
            `--target=${triple}`,
            "-std=c++20",
            "-fexceptions",
            "-frtti",
            "-fvisibility=hidden",
            "-DEVOLU_NATIVE_PACKAGE",
            "-DSQLITE_CUSTOM_INCLUDE=sqlite_config.h",
            `-I${native.packageDirectory}/native/include`,
            `-isystem${native.jsiDirectory}`,
            "-Wall",
            "-Wextra",
            "-Werror",
            "-c",
            `${native.packageDirectory}/cpp/EvoluSqliteBinding.cpp`,
            "-o",
            `${native.outputDirectory}/${target}/EvoluSqliteBinding.o`,
          ],
        ])
        .toSorted(byArguments),
    );
  });

  it("compiles for the iOS device and both simulators through xcrun, with Clang modules, gnu11 and C++20, as Xcode does", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    setNamedSymbols(toolchain);

    const results = await crossCompile({
      packageDirectory: native.packageDirectory,
      jsiDirectory: native.jsiDirectory,
      platform: { name: "ios" },
      outputDirectory: native.outputDirectory,
      jobs: 2,
      env: toolchain.env,
    });

    const targets = [
      ["ios-arm64", "arm64-apple-ios15.1", "iphoneos"],
      [
        "ios-simulator-arm64",
        "arm64-apple-ios15.1-simulator",
        "iphonesimulator",
      ],
      [
        "ios-simulator-x86_64",
        "x86_64-apple-ios15.1-simulator",
        "iphonesimulator",
      ],
    ];
    assertEqual(
      results,
      targets.map(([target]) => ({
        target,
        objects: 5,
        definedGlobals: 5,
        adapterSymbols: 11,
      })),
    );
    assertEqual(
      toolchain.commands().toSorted(byArguments),
      targets
        .flatMap(([target, triple, sdk]) => [
          ...native.units.map(([unit, extra]) => [
            "-target",
            triple,
            "-O2",
            "-std=gnu11",
            "-DEVOLU_NATIVE_PACKAGE",
            "-DSQLITE_CUSTOM_INCLUDE=sqlite_config.h",
            `-I${native.packageDirectory}/native/include`,
            ...extra,
            "-fmodules",
            `-fmodules-cache-path=${native.outputDirectory}/modules`,
            "-c",
            `${native.packageDirectory}/native/units/${unit}.c`,
            "-o",
            `${native.outputDirectory}/${target}/${unit}.o`,
            `--sdk=${sdk}`,
          ]),
          [
            "-target",
            triple,
            "-std=c++20",
            "-DEVOLU_NATIVE_PACKAGE",
            "-DSQLITE_CUSTOM_INCLUDE=sqlite_config.h",
            `-I${native.packageDirectory}/native/include`,
            `-isystem${native.jsiDirectory}`,
            "-Wall",
            "-Wextra",
            "-Werror",
            "-fmodules",
            `-fmodules-cache-path=${native.outputDirectory}/modules`,
            "-c",
            `${native.packageDirectory}/cpp/EvoluSqliteBinding.cpp`,
            "-o",
            `${native.outputDirectory}/${target}/EvoluSqliteBinding.o`,
            `--sdk=${sdk}`,
          ],
        ])
        .toSorted(byArguments),
    );
  });

  it("fails on a global the adapter defines that is neither evolu_, C++ of the namespaces evolu, std or facebook, nor the compiler's own, and on a SQLite name it references without evolu_", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    setNamedSymbols(toolchain);
    toolchain.setSymbols("EvoluSqliteBinding.cpp", [
      "_ZN5evolu13createBindingEv T 0 0",
      "_Z6helperv T 0 0",
      "_ZN4wtf13globalHelperEv W 0 0",
      "_ZTVN4wtf1AE S 0 0",
      // Namespaces that only start with an allowed one.
      "_ZN6evoluxE B 0 0",
      "_ZN9facebookx1fEv T 0 0",
      "helper T 0 0",
      "evolu_test_hook D 0 0",
      "sqlite3_step U",
    ]);

    await assertRejects(
      crossCompile({
        packageDirectory: native.packageDirectory,
        jsiDirectory: native.jsiDirectory,
        platform: { name: "ios" },
        outputDirectory: native.outputDirectory,
        jobs: 1,
        env: toolchain.env,
      }),
      (error) => {
        const lines = (error as Error).message.split("\n");
        assertEqual(lines.slice(0, 8), [
          "ios-arm64 cpp/EvoluSqliteBinding.cpp defines _Z6helperv, which isn't evolu_, C++ of evolu, std or facebook, or the compiler's.",
          "ios-arm64 cpp/EvoluSqliteBinding.cpp defines _ZN4wtf13globalHelperEv, which isn't evolu_, C++ of evolu, std or facebook, or the compiler's.",
          "ios-arm64 cpp/EvoluSqliteBinding.cpp defines _ZTVN4wtf1AE, which isn't evolu_, C++ of evolu, std or facebook, or the compiler's.",
          "ios-arm64 cpp/EvoluSqliteBinding.cpp defines _ZN6evoluxE, which isn't evolu_, C++ of evolu, std or facebook, or the compiler's.",
          "ios-arm64 cpp/EvoluSqliteBinding.cpp defines _ZN9facebookx1fEv, which isn't evolu_, C++ of evolu, std or facebook, or the compiler's.",
          "ios-arm64 cpp/EvoluSqliteBinding.cpp defines helper, which isn't evolu_, C++ of evolu, std or facebook, or the compiler's.",
          "ios-arm64 cpp/EvoluSqliteBinding.cpp defines evolu_test_hook, a test hook.",
          "ios-arm64 cpp/EvoluSqliteBinding.cpp references sqlite3_step without evolu_.",
        ]);
        assertEqual(lines.length, 24);
      },
    );
  });

  it("fails on a defined global without evolu_, an evolu_test_ one, and a SQLite, BearSSL or Monocypher name without evolu_, listing each", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    setNamedSymbols(toolchain);
    toolchain.setSymbols("evolu_codec.c", [
      "evolu_codec_open T 0 0",
      "helper T 0 0",
      "evolu_test_hook D 0 0",
      "sqlite3_open U",
      "sqlite3session_create U",
      "br_aes_ct_init U",
      "crypto_wipe U",
      "memcpy U",
    ]);

    await assertRejects(
      crossCompile({
        packageDirectory: native.packageDirectory,
        jsiDirectory: native.jsiDirectory,
        platform: { name: "ios" },
        outputDirectory: native.outputDirectory,
        jobs: 1,
        env: toolchain.env,
      }),
      (error) => {
        const lines = (error as Error).message.split("\n");
        assertEqual(lines.slice(0, 7), [
          "ios-arm64 units/evolu_codec.c defines helper, which isn't evolu_.",
          "ios-arm64 units/evolu_codec.c defines evolu_test_hook, a test hook.",
          "ios-arm64 units/evolu_codec.c references sqlite3_open without evolu_.",
          "ios-arm64 units/evolu_codec.c references sqlite3session_create without evolu_.",
          "ios-arm64 units/evolu_codec.c references br_aes_ct_init without evolu_.",
          "ios-arm64 units/evolu_codec.c references crypto_wipe without evolu_.",
          "ios-simulator-arm64 units/evolu_codec.c defines helper, which isn't evolu_.",
        ]);
        assertEqual(lines.length, 18);
      },
    );
  });

  it("fails on a failed compile with the compiler's output, after compiling the rest", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    setNamedSymbols(toolchain);
    toolchain.failCompile("sqlite3.c", "sqlite3.c:1:1: error: boom\n");

    await assertRejects(
      crossCompile({
        packageDirectory: native.packageDirectory,
        jsiDirectory: native.jsiDirectory,
        platform: { name: "android", ndk: toolchain.ndk },
        outputDirectory: native.outputDirectory,
        jobs: 4,
        env: toolchain.env,
      }),
      (error) => {
        assertEqual((error as Error).message.split("\n").slice(0, 2), [
          "android-arm64-v8a units/sqlite3.c failed to compile:",
          "sqlite3.c:1:1: error: boom",
        ]);
        assertTrue(
          (error as Error).message.includes(
            "android-x86_64 units/sqlite3.c failed to compile:",
          ),
        );
      },
    );
    assertEqual(toolchain.commands().length, 20);
  });

  it("refuses native/ that is missing its digest or was written for another native.json", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    const digest = join(native.packageDirectory, "native/native.json.sha256");
    const refused = (): Promise<unknown> =>
      assertRejects(
        crossCompile({
          packageDirectory: native.packageDirectory,
          jsiDirectory: native.jsiDirectory,
          platform: { name: "ios" },
          outputDirectory: native.outputDirectory,
          jobs: 1,
          env: toolchain.env,
        }),
        (error) => {
          assertEqual(
            (error as Error).message,
            "native/ is missing or was written for another native.json. Run node packages/react-native/scripts/vendor-native.mts first.",
          );
        },
      );

    writeFileSync(digest, `${"0".repeat(64)}\n`);
    await refused();
    rmSync(digest);
    await refused();
    assertEqual(toolchain.commands(), []);
  });

  it("refuses an NDK with other than one host toolchain", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    const prebuilt = join(toolchain.ndk, "toolchains/llvm/prebuilt");
    symlinkSync(join(prebuilt, "fake-host"), join(prebuilt, "other-host"));

    await assertRejects(
      crossCompile({
        packageDirectory: native.packageDirectory,
        jsiDirectory: native.jsiDirectory,
        platform: { name: "android", ndk: toolchain.ndk },
        outputDirectory: native.outputDirectory,
        jobs: 1,
        env: toolchain.env,
      }),
      (error) => {
        assertEqual(
          (error as Error).message,
          `${prebuilt} holds fake-host, other-host, not one host's toolchain.`,
        );
      },
    );
  });
});

describe("checkObjects", () => {
  it("passes the objects of an app's Evolu pod: the C's evolu_ globals, the adapter's C++, the TurboModule's class, and the ObjC++ classes with their protocols and C++ of std and facebook", (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    const objects = setupPodObjects(t);

    assertEqual(
      checkObjects({
        packageDirectory: native.packageDirectory,
        objectsDirectory: objects.directory,
        env: toolchain.env,
      }),
      { objects: 9, definedGlobals: 4, adapterSymbols: 22 },
    );
  });

  it("passes the version object Xcode compiles for a framework pod, defining the pod's version symbols", (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    const objects = setupPodObjects(t, {
      "EvoluReactNative_vers.o": [
        "EvoluReactNativeVersionNumber S 0 0",
        "EvoluReactNativeVersionString S 0 0",
      ],
    });

    assertEqual(
      checkObjects({
        packageDirectory: native.packageDirectory,
        objectsDirectory: objects.directory,
        env: toolchain.env,
      }),
      { objects: 10, definedGlobals: 4, adapterSymbols: 24 },
    );
  });

  it("allows the EvoluSqlite class only in the TurboModule's object, and an ObjC class only in its own, refusing what else isn't Evolu's", (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    const objects = setupPodObjects(t, {
      "EvoluSqliteBinding.o": [
        "_ZN5evolu13createBindingEv T 0 0",
        "_ZN11EvoluSqlite13createBindingERN8facebook3jsi7RuntimeE T 0 0",
      ],
      "EvoluApp.o": [
        "OBJC_CLASS_$_EvoluApp S 0 0",
        "OBJC_CLASS_$_EvoluSqliteProvider S 0 0",
        "_ZTV11EvoluSqlite S 0 0",
        "OBJC_CLASS_$_Other S 0 0",
        "sqlite3_open U",
      ],
      "EvoluSqlite.o": [
        "_ZN11EvoluSqliteD2Ev T 0 0",
        "_ZN12EvoluSqlitex1fEv T 0 0",
        "OBJC_CLASS_$_EvoluSqlite S 0 0",
        "evolu_test_hook D 0 0",
      ],
      "evolu_codec.o": [
        "evolu_codec_open T 0 0",
        "helper T 0 0",
        "evolu_test_hook D 0 0",
      ],
      "EvoluReactNative-dummy.o": [
        "OBJC_CLASS_$_PodsDummy_EvoluReactNative S 0 0",
        "OBJC_CLASS_$_PodsDummy_Other S 0 0",
      ],
      "EvoluReactNative_vers.o": [
        "EvoluReactNativeVersionNumber S 0 0",
        "sqlite3_open T 0 0",
      ],
      "Other.o": ["evolu_other T 0 0"],
    });
    rmSync(join(objects.directory, "EvoluSqliteProvider.o"));

    assertThrows(
      () =>
        checkObjects({
          packageDirectory: native.packageDirectory,
          objectsDirectory: objects.directory,
          env: toolchain.env,
        }),
      (error) => {
        assertEqual((error as Error).message.split("\n"), [
          "EvoluApp.o defines OBJC_CLASS_$_EvoluSqliteProvider, which isn't its ObjC class, ObjC protocol metadata, a block descriptor, C++ of std or facebook, or the compiler's.",
          "EvoluApp.o defines _ZTV11EvoluSqlite, which isn't its ObjC class, ObjC protocol metadata, a block descriptor, C++ of std or facebook, or the compiler's.",
          "EvoluApp.o defines OBJC_CLASS_$_Other, which isn't its ObjC class, ObjC protocol metadata, a block descriptor, C++ of std or facebook, or the compiler's.",
          "EvoluApp.o references sqlite3_open without evolu_.",
          "EvoluReactNative-dummy.o defines OBJC_CLASS_$_PodsDummy_Other, which isn't the pod's dummy class, ObjC protocol metadata, a block descriptor, C++ of std or facebook, or the compiler's.",
          "EvoluReactNative_vers.o defines sqlite3_open, which isn't the pod's version symbols that Xcode writes.",
          "EvoluSqlite.o defines _ZN12EvoluSqlitex1fEv, which isn't evolu_, C++ of evolu, std, facebook or the class EvoluSqlite, or the compiler's.",
          "EvoluSqlite.o defines OBJC_CLASS_$_EvoluSqlite, which isn't evolu_, C++ of evolu, std, facebook or the class EvoluSqlite, or the compiler's.",
          "EvoluSqlite.o defines evolu_test_hook, a test hook.",
          "EvoluSqliteBinding.o defines _ZN11EvoluSqlite13createBindingERN8facebook3jsi7RuntimeE, which isn't evolu_, C++ of evolu, std or facebook, or the compiler's.",
          "Other.o isn't an object of Evolu's pod.",
          "evolu_codec.o defines helper, which isn't evolu_.",
          "evolu_codec.o defines evolu_test_hook, a test hook.",
          "EvoluSqliteProvider.o, an object of Evolu's pod, is missing.",
        ]);
      },
    );
  });
});

describe("runVendorNativeCli", () => {
  it("checks the objects of an app's Evolu pod, printing what it found", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    const objects = setupPodObjects(t);
    const logged: Array<string> = [];
    const log = t.mock.method(console, "log", (line: string) => {
      logged.push(line);
    });

    await runVendorNativeCli([`--check-objects=${objects.directory}`], {
      packageDirectory: native.packageDirectory,
      env: toolchain.env,
    });
    log.mock.restore();

    assertEqual(logged, [
      `${objects.directory}: 9 objects; the C's 4 defined globals, each evolu_, and the adapters' 22.`,
    ]);
  });

  it("cross-compiles for Android with the NDK it names and for iOS, printing each target", async (t) => {
    const toolchain = setupFakeToolchain(t);
    const native = setupNative(t);
    setNamedSymbols(toolchain);
    const logged: Array<string> = [];
    const log = t.mock.method(console, "log", (line: string) => {
      logged.push(line);
    });

    await runVendorNativeCli(
      ["--cross-compile=android", `--ndk=${toolchain.ndk}`, "--jobs=2"],
      { packageDirectory: native.packageDirectory, env: toolchain.env },
    );
    await runVendorNativeCli(["--cross-compile=ios"], {
      packageDirectory: native.packageDirectory,
      env: toolchain.env,
    });
    log.mock.restore();

    const line = (target: string) =>
      `${target}: 5 objects; the C's 5 defined globals, each evolu_, and the adapter's 11.`;
    assertEqual(logged, [
      line("android-arm64-v8a"),
      line("android-armeabi-v7a"),
      line("android-x86"),
      line("android-x86_64"),
      line("ios-arm64"),
      line("ios-simulator-arm64"),
      line("ios-simulator-x86_64"),
    ]);
    assertEqual(toolchain.commands().length, 35);
    // The objects went into a temporary directory, which is gone.
    for (const command of toolchain.commands())
      assertFalse(existsSync(dirname(command[command.indexOf("-o") + 1])));
  });

  it("refuses arguments it can't act on", async () => {
    for (const [args, message] of [
      [
        ["--check", "--update"],
        "Pass at most one of --check, --update, --cross-compile and --check-objects.",
      ],
      [
        ["--update", "--cross-compile=ios"],
        "Pass at most one of --check, --update, --cross-compile and --check-objects.",
      ],
      [
        ["--check", "--check-objects=objects"],
        "Pass at most one of --check, --update, --cross-compile and --check-objects.",
      ],
      [["--cross-compile=windows"], "--cross-compile takes android or ios."],
      [
        ["--cross-compile=android"],
        "--cross-compile=android needs --ndk=<the NDK's directory>.",
      ],
      [["--cross-compile=ios", "--jobs=0"], "--jobs takes a positive integer."],
      [
        ["--cross-compile=ios", "--jobs=two"],
        "--jobs takes a positive integer.",
      ],
    ] as const)
      await assertRejects(
        runVendorNativeCli(args, {
          packageDirectory: tmpdir(),
          env: process.env,
        }),
        (error) => {
          assertEqual((error as Error).message, message);
        },
      );
  });
});

/** A fake clang, llvm-nm and xcrun, and a fake NDK holding the first two. */
interface FakeToolchain {
  readonly ndk: string;
  readonly cc: string;
  /** The environment with the fake xcrun first in PATH. */
  readonly env: NodeJS.ProcessEnv;
  /**
   * Sets the llvm-nm -P lines, without the C label prefix, of the objects
   * compiled from sources with this basename.
   */
  readonly setSymbols: (source: string, lines: ReadonlyArray<string>) => void;
  /** Makes compiles of sources with this basename fail with this output. */
  readonly failCompile: (source: string, output: string) => void;
  /** The arguments of each compile, in no particular order. */
  readonly commands: () => ReadonlyArray<ReadonlyArray<string>>;
}

/**
 * Sets up a fake toolchain in a new directory. The fake clang prints a C label
 * prefix of `_` for Apple targets and none otherwise, prints the fake llvm-nm
 * for -print-prog-name, and for a compile records its arguments and writes as
 * the object the symbol lines set for the source's basename, with the prefix.
 * The fake llvm-nm prints an object's lines, without undefined ones under
 * --defined-only. The fake xcrun runs the fake clang with `--sdk=<sdk>` last.
 */
const setupFakeToolchain = (t: TestContext): FakeToolchain => {
  const directory = mkdtempSync(join(tmpdir(), "evolu-react-native-fake-"));
  t.after(() => {
    rmSync(directory, { recursive: true, force: true });
  });
  const ndk = join(directory, "ndk");
  const bin = join(ndk, "toolchains/llvm/prebuilt/fake-host/bin");
  const path = join(directory, "path");
  const commandsDirectory = join(directory, "commands");
  for (const created of [
    bin,
    path,
    commandsDirectory,
    join(directory, "symbols"),
    join(directory, "failed"),
  ])
    mkdirSync(created, { recursive: true });
  const cc = join(bin, "clang");
  writeFileSync(
    cc,
    [
      "#!/bin/sh",
      `state='${directory}'`,
      "prefix=",
      "for argument; do",
      '  case "$argument" in',
      "    --version) echo 'fake clang'; exit ;;",
      `    -print-prog-name=*) echo "${bin}/\${argument#-print-prog-name=}"; exit ;;`,
      "    *-apple-*) prefix=_ ;;",
      "  esac",
      "done",
      'for argument; do case "$argument" in -dM) echo "#define __USER_LABEL_PREFIX__ $prefix"; exit ;; esac; done',
      "# A file per compile, since compiles run at once.",
      'printf \'%s\\n\' "$@" > "$(mktemp "$state/commands/XXXXXX")"',
      'while [ $# -gt 0 ]; do case "$1" in -c) source=$2 ;; -o) output=$2 ;; esac; shift; done',
      'name=$(basename "$source")',
      'if [ -e "$state/failed/$name" ]; then cat "$state/failed/$name" >&2; exit 1; fi',
      'if [ -e "$state/symbols/$name" ]; then sed "s/^/$prefix/" "$state/symbols/$name" > "$output"; else : > "$output"; fi',
      "",
    ].join("\n"),
    { mode: 0o755 },
  );
  writeFileSync(
    join(bin, "llvm-nm"),
    [
      "#!/bin/sh",
      "defined=false",
      'for argument; do case "$argument" in --defined-only) defined=true ;; esac; object=$argument; done',
      'if [ "$defined" = true ]; then awk \'$2 !~ /^[Uwv]$/\' "$object"; else cat "$object"; fi',
      "",
    ].join("\n"),
    { mode: 0o755 },
  );
  writeFileSync(
    join(path, "xcrun"),
    [
      "#!/bin/sh",
      '[ "$1" = --sdk ] && [ "$3" = clang ] || { echo "xcrun: unexpected $*" >&2; exit 1; }',
      "# xcrun --sdk <sdk> clang <arguments>",
      "sdk=$2",
      "shift 3",
      `exec '${cc}' "$@" "--sdk=$sdk"`,
      "",
    ].join("\n"),
    { mode: 0o755 },
  );
  return {
    ndk,
    cc,
    env: { ...process.env, PATH: `${path}:${process.env.PATH}` },
    setSymbols: (source, lines) => {
      writeFileSync(
        join(directory, "symbols", source),
        lines.map((line) => `${line}\n`).join(""),
      );
    },
    failCompile: (source, output) => {
      writeFileSync(join(directory, "failed", source), output);
    },
    commands: () =>
      readdirSync(commandsDirectory).map((file) =>
        readFileSync(join(commandsDirectory, file), "utf8")
          .split("\n")
          .slice(0, -1),
      ),
  };
};

/**
 * A stand-in for `@evolu/sqlite-core` and the amalgamation in a new directory,
 * with the compile units the vendor script gets, and a directory to write
 * native/ into.
 */
const setupCore = (t: TestContext) => {
  const root = mkdtempSync(join(tmpdir(), "evolu-react-native-core-"));
  t.after(() => {
    rmSync(root, { recursive: true, force: true });
