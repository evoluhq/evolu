  const sqliteDirectory = join(coreDirectory, "sqlite-cache/sqlite-src");
  const files = {
    "src/evolu_codec.c": '#include "evolu_codec.h"\n',
    "src/evolu_codec.h": '#include "sqlite3.h"\n',
    "src/evolu_xchacha.h": "#include <stdint.h>\n",
    "src/sqlite_config.h": "#define SQLITE_THREADSAFE 2\n",
    "binding/evolu_database.c": '#include "evolu_database.h"\n',
    "binding/evolu_database.h": '#include "evolu_sqlite3.h"\n',
    "binding/evolu_sqlite3.h": '#include "sqlite3.h"\n',
    "vendor/lib/inc/lib.h": "void br_aes_init(void);\n",
    "vendor/lib/src/aes.c": '#include "inner.h"\n',
    "vendor/lib/src/inner.h": '#include "lib.h"\n',
    "vendor/mono/monocypher.c": '#include "monocypher.h"\n',
