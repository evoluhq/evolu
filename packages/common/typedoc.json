  "intentionallyNotExported": [
    /**
     * Suppresses warnings for 'Type.Type' when referenced in patterns like:
     *
     * ```ts
     * export type Foo = typeof Foo.Type;
     * ```
     */
    "Type.Type",
    "SelectQueryBuilderExpression",
    /**
     * Type2 is intentionally excluded from generated API docs until it replaces
     * Type. The intl entry point already references its structured error types.
     */
    "ArrayError",
    "BetweenError",
    "CapitalizedError",
    "DateIsoError",
    "DiscriminatedUnionError",
    "FiniteError",
    "GreaterThanError",
    "GreaterThanOrEqualToError",
    "InstanceOfError",
    "Int64Error",
    "IntError",
    "JsonError",
    "JsonValueError",
    "LengthError",
    "LessThanError",
