{
  "extends": [
    "@tsconfig/svelte/tsconfig.json",
    "@evolu/typescript-config/base.json"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src", "svelte-types.d.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../common" }, { "path": "../web" }]
}
