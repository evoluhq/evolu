/**
 * Keeps test/xchacha_vectors.h, the vectors with which xchacha_test.c checks
 * the C core's XChaCha20-Poly1305, generated from Evolu's current
 * implementation: `encryptWithXChaCha20Poly1305` of `@evolu/common`, which
 * calls noble's `xchacha20poly1305`. It's a cross-implementation check, so the
 * C core must write the exact bytes that Evolu's TypeScript writes and reads.
 *
 * Keys and nonces are fixed and the plaintexts follow a formula that
 * xchacha_test.c repeats, so the output is deterministic. A vector holds the
 * tag and a 64-bit FNV-1a checksum of the ciphertext rather than the
 * ciphertext, which would add 64 KiB of source for the longest one. The
 * checksum only has to catch accidental differences, and the tag is a MAC over
 * the whole ciphertext anyway.
 *
 * To generate the header again:
 *
 *     pnpm test:node --test-update-snapshots packages/sqlite-core/test/xchacha-vectors.test.mts
 */
import {
  assert,
  EncryptionKey,
  encryptWithXChaCha20Poly1305,
  type RandomBytes,
} from "@evolu/common";
import { it } from "node:test";
import { fileURLToPath } from "node:url";

/**
 * Plaintext lengths: empty, one byte, around one Poly1305 block, a partial last
 * ChaCha20 block, whole ChaCha20 blocks, and many blocks.
 */
const lengths = [0, 1, 15, 16, 17, 255, 1024, 65536];

it("keeps the XChaCha20-Poly1305 vectors of xchacha_vectors.h generated from Evolu's TypeScript", (t) => {
  const vectors = lengths.map((length, index) => {
    // Distinct fixed keys and nonces for each vector.
    const key = Uint8Array.from(
      { length: 32 },
      (_, i) => (i * 7 + index * 11 + 1) & 0xff,
    );
    const nonce = Uint8Array.from(
      { length: 24 },
      (_, i) => (i * 13 + index * 5 + 2) & 0xff,
    );
    // xchacha_test.c computes the same bytes in vector_plaintext_byte.
    const plaintext = Uint8Array.from(
      { length },
      (_, i) => (i * 31 + 7) & 0xff,
    );
    // Evolu's function takes its nonce from RandomBytes; this one returns the
    // fixed nonce.
    const randomBytes = {
      create: (bytesLength: number) => {
        assert(bytesLength === nonce.length, "The nonce has 24 bytes.");
        return nonce;
      },
    } as RandomBytes;
    const [output, outputNonce] = encryptWithXChaCha20Poly1305({
      randomBytes,
    })(plaintext, EncryptionKey.orThrow(key));
    assert(
      outputNonce === nonce && output.length === length + 16,
      "The output is the ciphertext and the tag, with the fixed nonce.",
    );

    // 64-bit FNV-1a, which xchacha_test.c computes in fnv1a64.
    let checksum = 0xcbf29ce484222325n;
    for (const byte of output.subarray(0, length))
      checksum =
        ((checksum ^ BigInt(byte)) * 0x100000001b3n) & 0xffffffffffffffffn;
    return [
      "    {",
      `        .length = ${length},`,
      bytesToC("        .key = ", key),
      bytesToC("        .nonce = ", nonce),
      bytesToC("        .tag = ", output.subarray(length)),
      `        .ciphertext_checksum = UINT64_C(0x${checksum.toString(16).padStart(16, "0")}),`,
      "    },",
    ].join("\n");
  });

  t.assert.fileSnapshot(
    [
      "// Generated by xchacha-vectors.test.mts; don't edit. xchacha_test.c",
      "// includes it after it declares struct noble_vector.",
      "static const struct noble_vector noble_vectors[] = {",
      ...vectors,
      "};",
      "",
    ].join("\n"),
    fileURLToPath(new URL("xchacha_vectors.h", import.meta.url)),
    { serializers: [(header: string) => header] },
  );
});

/**
 * Formats bytes as a C array initializer field, wrapped within 80 columns under
 * its opening brace.
 */
const bytesToC = (prefix: string, bytes: Uint8Array): string => {
  const indent = " ".repeat(prefix.length + 1);
  const lines = [`${prefix}{`];
  for (const [i, byte] of bytes.entries()) {
    const item = `0x${byte.toString(16).padStart(2, "0")}`;
    const last = lines.length - 1;
    const line = lines[last];
    const separator = line.endsWith("{") ? "" : " ";
    // Every item but the last is followed by a comma; the last by "},".
    if (line.length + separator.length + item.length + 2 > 80)
      lines.push(`${indent}${item}`);
    else lines[last] = `${line}${separator}${item}`;
    lines[lines.length - 1] += i === bytes.length - 1 ? "}," : ",";
  }
  return lines.join("\n");
};
