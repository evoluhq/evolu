/**
 * Host builds of the C core for its tests: SQLite, the vendored libraries and
 * the core compiled with AddressSanitizer and UndefinedBehaviorSanitizer, the
 * core's own C and tests with warnings as errors, each into a cached object.
 *
 * Each test file `test/<name>_test.c` defines `void <name>_suite(void)`; the
 * build generates the runner's list of suites from the file names, so adding a
 * test file needs no other change.
 *
 * @module
 */
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { basename, join } from "node:path";
import {
  compileCached,
  compileVendoredLibraries,
  cSources,
  headerContents,
  run,
  sourceDirectory,
  testDirectory,
  vendoredPublicHeaders,
  vendoredPublicIncludes,
  writeAtomically,
} from "./compile.mts";
import type { PinnedSqliteSource, PreparedSqlite } from "./sqlite-source.mts";

/**
 * Builds the C test runner and returns its path. Objects of SQLite and the
 * vendored libraries are kept in `outputDirectory` under names derived from
 * their inputs, so only the core and the tests compile again while those stay
 * the same.
 */
export const buildTestRunner = ({
  sqlite,
  source,
  outputDirectory,
  cc = "clang",
}: {
  sqlite: PreparedSqlite;
  source: PinnedSqliteSource;
  outputDirectory: string;
  cc?: string;
}): string => {
  const sanitized = [
    "-std=c11",
    "-g",
    "-O1",
    "-fno-omit-frame-pointer",
    "-fsanitize=address,undefined",
    "-fno-sanitize-recover=all",
  ];
  const sqliteFlags = [
    ...sanitized,
    `-I${sqlite.directory}`,
    `-I${sourceDirectory}`,
    "-DSQLITE_CUSTOM_INCLUDE=sqlite_config.h",
  ];
  const objectsDirectory = join(outputDirectory, "objects");
  mkdirSync(outputDirectory, { recursive: true });

  const sqliteObject = compileCached({
    cc,
    flags: sqliteFlags,
    source: sqlite.sqlite3c,
    extraKey: () =>
      readFileSync(join(sourceDirectory, "sqlite_config.h"), "utf8"),
    objectsDirectory,
  });
  const vendoredObjects = compileVendoredLibraries({
    cc,
    flags: sanitized,
    objectsDirectory,
  });

  const testFiles = cSources(testDirectory);
  const suites = testFiles
    .map((file) => basename(file, ".c"))
    .filter((name) => name.endsWith("_test"))
    .map((name) => `${name.slice(0, -"_test".length)}_suite`);
  const suitesFile = join(outputDirectory, "suites.c");
  writeAtomically(suitesFile, (output) => {
    writeFileSync(
      output,
      [
        "/* Generated by scripts/build.mts from the test file names. */",
        ...suites.map((suite) => `void ${suite}(void);`),
        "void run_suites(void);",
        "void run_suites(void) {",
        ...suites.map((suite) => `  ${suite}();`),
        "}",
        "",
      ].join("\n"),
    );
  });

  // Each object of the core and the tests depends on every header of both
  // and the vendored headers they may include.
  const headers = (): string =>
    [
      headerContents(sourceDirectory),
      headerContents(testDirectory),
      vendoredPublicHeaders(),
    ].join("\n");
  const testObjects = [
    ...cSources(sourceDirectory),
    ...testFiles,
    suitesFile,
  ].map((file) =>
    compileCached({
      cc,
      flags: [
        ...sqliteFlags,
        ...vendoredPublicIncludes(),
        "-Wall",
        "-Wextra",
        "-Werror",
        `-DEVOLU_TEST_SQLITE_VERSION="${source.version}"`,
        `-DEVOLU_TEST_SQLITE_CHECK_IN="${source.checkIn}"`,
        // The crypto layer's hooks: a probe of primitives that run without DIT
        // and a random source that fails.
        "-DEVOLU_TEST_HOOKS",
      ],
      source: file,
      extraKey: headers,
      objectsDirectory,
    }),
  );

  const runner = join(outputDirectory, "core-tests");
  writeAtomically(runner, (output) => {
    run(cc, [
      ...sanitized,
      ...testObjects,
      sqliteObject,
      ...vendoredObjects,
      // The codec's tests open databases on several threads.
      "-pthread",
      "-lm",
      "-o",
      output,
    ]);
  });
  return runner;
};
