{
  "name": "@evolu/oxlint-config",
  "version": "0.3.4",
  "description": "Strict Oxlint configuration and custom rules for Evolu projects",
  "keywords": [
    "evolu",
    "oxlint",
    "lint"
  ],
  "author": "Daniel Steigerwald <daniel@steigerwald.cz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoluhq/evolu.git"
  },
  "bugs": {
    "url": "https://github.com/evoluhq/evolu/issues"
  },
  "homepage": "https://evolu.dev",
  "type": "module",
  "exports": {
    "./config.jsonc": "./config.jsonc",
    "./plugin": {
      "types": "./src/plugin.d.mts",
      "default": "./src/plugin.mjs"
    }
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "config.jsonc",
    "README.md",
    "src/**"
  ],
  "dependencies": {
    "eslint-plugin-jsdoc": "65.3.4"
  },
  "devDependencies": {
    "@evolu/typescript-config": "workspace:*",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "peerDependencies": {
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./config.jsonc": "./config.jsonc",
      "./plugin": {
        "types": "./src/plugin.d.mts",
        "default": "./src/plugin.mjs"
      }
    }
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "sideEffects": false
}
