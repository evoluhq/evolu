{
  "extends": "../packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["dom", "esnext", "webworker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "target": "es2022",
    "paths": {
      "@evolu/common": ["../packages/common/src/index.ts"],
      "@evolu/common/intl": ["../packages/common/src/intl/index.ts"],
      "@evolu/common/local-first": [
        "../packages/common/src/local-first/index.ts"
      ],
      "@evolu/common/polyfills": ["../packages/common/src/Polyfills.ts"],
      "@evolu/nodejs/TestJSDoc": ["../packages/nodejs/src/TestJSDoc.ts"],
      "@evolu/vitest": ["../packages/vitest/src/index.ts"],
      "@evolu/vitest/BrowserConfig": ["../packages/vitest/src/BrowserConfig.ts"]
    },
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.mts", "../vitest.config.mts"],
  // It re-exports the types of @evolu/react-native's main entry, whose specs
  // bring React Native's globals, such as a setTimeout that returns a number,
  // into the whole project. test:jsdoc type-checks it with the examples that
  // import it.
  "exclude": ["jsdoc/test-jsdoc-react-native.mts"]
}
